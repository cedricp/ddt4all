msgstr "Komut makroları"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"HATA: komut 5 parametreye sahip olmalıdır: \n"
"    <komut> <lid> <rsp_len> <ofset> <hex maske> <hex değer>\n"
"        <lid> - ECU yerel tanımlayıcısı. Uzunluk KWP için 2 veya CAN için 4 "
"sembol olmalıdır\n"
"        <rsp_len> - olumlu yanıt baytları dahil komut yanıtının uzunluğu, "
"ddt veritabanındaki MinBytes değerine eşittir\n"
"        <ofset> - ilk değiştirilen bayta bayt cinsinden ofset (0'dan değil "
"1'den başlar) \n"
"        <hex maske> - değiştirilen bitler için bit maskesi, 1 - "
"değiştirilebilir, 0 - dokunulamaz\n"
"        <hex değer> - bit değeri\n"
"    <hex maske> ve <hex değer> eşit uzunlukta olmalıdır\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"HATA: komut 6 parametreye sahip olmalıdır: \n"
"    <komut> <lid> <rsp_len> <ofset> <hex maske> <hex değer> <etiket>\n"
"        <lid> - ECU yerel tanımlayıcısı. Uzunluk KWP için 2 veya CAN için 4 "
"sembol olmalıdır\n"
"        <rsp_len> - olumlu yanıt baytları dahil komut yanıtının uzunluğu, "
"ddt veritabanındaki MinBytes değerine eşittir\n"
"        <ofset> - ilk değiştirilen bayta bayt cinsinden ofset (0'dan değil "
"1'den başlar) \n"
"        <hex maske> - değiştirilen bitler için bit maskesi, 1 - "
"değiştirilebilir, 0 - dokunulamaz\n"
"        <hex değer> - bit değeri\n"
"        <etiket> - gidilecek etiket\n"
"    <hex maske> ve <hex değer> eşit uzunlukta olmalıdır\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"HATA: komut 4 veya 7 parametreye sahip olmalıdır: \n"
"    <komut> <lid> <rsp_len> <ofset> <hex maske> <hex değer> <etiket>\n"
"        <lid> - ECU yerel tanımlayıcısı. Uzunluk KWP için 2 veya CAN için 4 "
"sembol olmalıdır\n"
"        <rsp_len> - olumlu yanıt baytları dahil komut yanıtının uzunluğu, "
"ddt veritabanındaki MinBytes değerine eşittir\n"
"        <ofset> - ilk değiştirilen bayta bayt cinsinden ofset (0'dan değil "
"1'den başlar) \n"
"        <hex maske> - değiştirilen bitler için bit maskesi, 1 - "
"değiştirilebilir, 0 - dokunulamaz\n"
"        <değer adımı> - değer adımı\n"
"        <değer ofseti> - değer ofseti\n"
"        <değer böleni> - değer bölücüsü\n"
"\n"

