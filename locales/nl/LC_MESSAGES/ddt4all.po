msgid "Macros"
msgstr "Opdrachtmacro's"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"FOUT: opdracht moet 5 parameters hebben: \n"
"    <opdracht> <lid> <rsp_len> <offset> <hex masker> <hex waarde>\n"
"        <lid> - Lokale ECU-identificatie. Lengte moet 2 tekens zijn voor KWP "
"of 4 voor CAN\n"
"        <rsp_len> - lengte van opdrachtrespons inclusief positieve "
"responsbytes, gelijk aan MinBytes uit ddt-database\n"
"        <offset> - offset in bytes naar eerste gewijzigde byte (begint bij "
"1, niet 0) \n"
"        <hex masker> - bitmasker voor gewijzigde bits, 1 - wijzigbaar, 0 - "
"onaantastbaar\n"
"        <hex waarde> - bitwaarde\n"
"    <hex masker> en <hex waarde> moeten gelijke lengte hebben\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"FOUT: opdracht moet 6 parameters hebben: \n"
"    <opdracht> <lid> <rsp_len> <offset> <hex masker> <hex waarde> <label>\n"
"        <lid> - Lokale ECU-identificatie. Lengte moet 2 tekens zijn voor KWP "
"of 4 voor CAN\n"
"        <rsp_len> - lengte van opdrachtrespons inclusief positieve "
"responsbytes, gelijk aan MinBytes uit ddt-database\n"
"        <offset> - offset in bytes naar eerste gewijzigde byte (begint bij "
"1, niet 0) \n"
"        <hex masker> - bitmasker voor gewijzigde bits, 1 - wijzigbaar, 0 - "
"onaantastbaar\n"
"        <hex waarde> - bitwaarde\n"
"        <label> - doellabel\n"
"    <hex masker> en <hex waarde> moeten gelijke lengte hebben\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"FOUT: opdracht moet 4 of 7 parameters hebben: \n"
"    <opdracht> <lid> <rsp_len> <offset> <hex masker> <hex waarde> <label>\n"
"        <lid> - Lokale ECU-identificatie. Lengte moet 2 tekens zijn voor KWP "
"of 4 voor CAN\n"
"        <rsp_len> - lengte van opdrachtrespons inclusief positieve "
"responsbytes, gelijk aan MinBytes uit ddt-database\n"
"        <offset> - offset in bytes naar eerste gewijzigde byte (begint bij "
"1, niet 0) \n"
"        <hex masker> - bitmasker voor gewijzigde bits, 1 - wijzigbaar, 0 - "
"onaantastbaar\n"
"        <waarde stap> - waardestap\n"
"        <waarde offset> - waarde-offset\n"
"        <waardedeler> - waardedeler\n"
"\n"

