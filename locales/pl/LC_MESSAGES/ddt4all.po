msgstr "Makra poleceń"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"BŁĄD: polecenie musi mieć 5 parametrów: \n"
"    <polecenie> <lid> <rsp_len> <przesunięcie> <maska hex> <wartość hex>\n"
"        <lid> - lokalny identyfikator ECU. Długość powinna wynosić 2 znaki "
"dla KWP lub 4 dla CAN\n"
"        <rsp_len> - długość odpowiedzi polecenia wraz z bajtami odpowiedzi "
"pozytywnej, równa MinBytes z bazy ddt\n"
"        <przesunięcie> - przesunięcie w bajtach do pierwszego zmienionego "
"bajtu (zaczyna się od 1, nie od 0) \n"
"        <maska hex> - maska bitowa zmienionych bitów, 1 - modyfikowalny, 0 - "
"nienaruszalny\n"
"        <wartość hex> - wartość bitowa\n"
"    <maska hex> i <wartość hex> muszą mieć jednakową długość\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"BŁĄD: polecenie musi mieć 6 parametrów: \n"
"    <polecenie> <lid> <rsp_len> <przesunięcie> <maska hex> <wartość hex> "
"<etykieta>\n"
"        <lid> - lokalny identyfikator ECU. Długość powinna wynosić 2 znaki "
"dla KWP lub 4 dla CAN\n"
"        <rsp_len> - długość odpowiedzi polecenia wraz z bajtami odpowiedzi "
"pozytywnej, równa MinBytes z bazy ddt\n"
"        <przesunięcie> - przesunięcie w bajtach do pierwszego zmienionego "
"bajtu (zaczyna się od 1, nie od 0) \n"
"        <maska hex> - maska bitowa zmienionych bitów, 1 - modyfikowalny, 0 - "
"nienaruszalny\n"
"        <wartość hex> - wartość bitowa\n"
"        <etykieta> - etykieta docelowa\n"
"    <maska hex> i <wartość hex> muszą mieć jednakową długość\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"BŁĄD: polecenie musi mieć 4 lub 7 parametrów: \n"
"    <polecenie> <lid> <rsp_len> <przesunięcie> <maska hex> <wartość hex> "
"<etykieta>\n"
"        <lid> - lokalny identyfikator ECU. Długość powinna wynosić 2 znaki "
"dla KWP lub 4 dla CAN\n"
"        <rsp_len> - długość odpowiedzi polecenia wraz z bajtami odpowiedzi "
"pozytywnej, równa MinBytes z bazy ddt\n"
"        <przesunięcie> - przesunięcie w bajtach do pierwszego zmienionego "
"bajtu (zaczyna się od 1, nie od 0) \n"
"        <maska hex> - maska bitowa zmienionych bitów, 1 - modyfikowalny, 0 - "
"nienaruszalny\n"
"        <krok wartości> - krok wartości\n"
"        <przesunięcie wartości> - przesunięcie wartości\n"
"        <dzielnik wartości> - dzielnik wartości\n"
"\n"

