msgid "DDT2000 command macros (.cmd)"
msgstr "Macros de commande DDT2000 (.cmd)"

msgid "Macros"
msgstr "Macros de commande"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ERREUR : la commande doit comporter 5 paramètres : \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - identifiant local du calculateur (ECU). La longueur doit "
"être de 2 symboles pour KWP ou 4 pour CAN\n"
"        <rsp_len> - longueur de la réponse incluant les octets de réponse "
"positive, équivaut à MinBytes de la base ddt\n"
"        <offset> - décalage en octets jusqu'au premier octet modifié "
"(commence à 1 et non à 0) \n"
"        <hex mask> - masque binaire des bits modifiés, 1 - modifiable, 0 - "
"intouchable\n"
"        <hex value> - valeur binaire\n"
"    <hex mask> et <hex value> doivent avoir la même longueur\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ERREUR : la commande doit comporter 6 paramètres : \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - identifiant local du calculateur (ECU). La longueur doit "
"être de 2 symboles pour KWP ou 4 pour CAN\n"
"        <rsp_len> - longueur de la réponse incluant les octets de réponse "
"positive, équivaut à MinBytes de la base ddt\n"
"        <offset> - décalage en octets jusqu'au premier octet modifié "
"(commence à 1 et non à 0) \n"
"        <hex mask> - masque binaire des bits modifiés, 1 - modifiable, 0 - "
"intouchable\n"
"        <hex value> - valeur binaire\n"
"        <label> - étiquette de destination\n"
"    <hex mask> et <hex value> doivent avoir la même longueur\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"ERREUR : la commande doit comporter 4 ou 7 paramètres : \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - identifiant local du calculateur (ECU). La longueur doit "
"être de 2 symboles pour KWP ou 4 pour CAN\n"
"        <rsp_len> - longueur de la réponse incluant les octets de réponse "
"positive, équivaut à MinBytes de la base ddt\n"
"        <offset> - décalage en octets jusqu'au premier octet modifié "
"(commence à 1 et non à 0) \n"
"        <hex mask> - masque binaire des bits modifiés, 1 - modifiable, 0 - "
"intouchable\n"
"        <val step> - pas de la valeur\n"
"        <val offset> - décalage de la valeur\n"
"        <val divider> - diviseur de la valeur\n"
"\n"

