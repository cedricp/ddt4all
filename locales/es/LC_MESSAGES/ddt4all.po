msgid "DDT2000 command macros (.cmd)"
msgstr "Macros de comandos DDT2000 (.cmd)"

msgid "Macros"
msgstr "Macros de comandos"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ERROR: el comando debe tener 5 parámetros: \n"
"    <comando> <lid> <rsp_len> <desplazamiento> <máscara hex> <valor hex>\n"
"        <lid> - identificador local de la ECU. La longitud debe ser de 2 "
"símbolos para KWP o 4 para CAN\n"
"        <rsp_len> - longitud de respuesta del comando incluyendo bytes de "
"respuesta positiva, igual a MinBytes de la base ddt\n"
"        <desplazamiento> - desplazamiento en bytes hasta el primer byte "
"cambiado (comienza en 1, no en 0) \n"
"        <máscara hex> - máscara de bits para bits cambiados, 1 - "
"modificable, 0 - intocable\n"
"        <valor hex> - valor del bit\n"
"    <máscara hex> y <valor hex> deben tener la misma longitud\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ERROR: el comando debe tener 6 parámetros: \n"
"    <comando> <lid> <rsp_len> <desplazamiento> <máscara hex> <valor hex> "
"<etiqueta>\n"
"        <lid> - identificador local de la ECU. La longitud debe ser de 2 "
"símbolos para KWP o 4 para CAN\n"
"        <rsp_len> - longitud de respuesta del comando incluyendo bytes de "
"respuesta positiva, igual a MinBytes de la base ddt\n"
"        <desplazamiento> - desplazamiento en bytes hasta el primer byte "
"cambiado (comienza en 1, no en 0) \n"
"        <máscara hex> - máscara de bits para bits cambiados, 1 - "
"modificable, 0 - intocable\n"
"        <valor hex> - valor del bit\n"
"        <etiqueta> - etiqueta de destino\n"
"    <máscara hex> y <valor hex> deben tener la misma longitud\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"ERROR: el comando debe tener 4 o 7 parámetros: \n"
"    <comando> <lid> <rsp_len> <desplazamiento> <máscara hex> <valor hex> "
"<etiqueta>\n"
"        <lid> - identificador local de la ECU. La longitud debe ser de 2 "
"símbolos para KWP o 4 para CAN\n"
"        <rsp_len> - longitud de respuesta del comando incluyendo bytes de "
"respuesta positiva, igual a MinBytes de la base ddt\n"
"        <desplazamiento> - desplazamiento en bytes hasta el primer byte "
"cambiado (comienza en 1, no en 0) \n"
"        <máscara hex> - máscara de bits para bits cambiados, 1 - "
"modificable, 0 - intocable\n"
"        <paso del valor> - paso del valor\n"
"        <desplazamiento del valor> - desplazamiento del valor\n"
"        <divisor del valor> - divisor del valor\n"
"\n"

