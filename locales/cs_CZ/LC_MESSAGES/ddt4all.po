msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"CHYBA: příkaz musí mít 5 parametrů: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - místní identifikátor ECU. Délka by měla být 2 znaky pro KWP "
"nebo 4 pro CAN\n"
"        <rsp_len> - délka odpovědi na příkaz včetně bajtů kladné odpovědi, "
"odpovídá MinBytes z databáze ddt\n"
"        <offset> - posun v bajtech k prvnímu změněnému bajtu (začíná od 1, "
"nikoli od 0) \n"
"        <hex mask> - bitová maska pro změněné bity, 1 - měnitelný, 0 - "
"nedotknutelný\n"
"        <hex value> - hodnota bitu\n"
"    <hex mask> a <hex value> musí mít stejnou délku\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"CHYBA: příkaz musí mít 6 parametrů: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - místní identifikátor ECU. Délka by měla být 2 znaky pro KWP "
"nebo 4 pro CAN\n"
"        <rsp_len> - délka odpovědi na příkaz včetně bajtů kladné odpovědi, "
"odpovídá MinBytes z databáze ddt\n"
"        <offset> - posun v bajtech k prvnímu změněnému bajtu (začíná od 1, "
"nikoli od 0) \n"
"        <hex mask> - bitová maska pro změněné bity, 1 - měnitelný, 0 - "
"nedotknutelný\n"
"        <hex value> - hodnota bitu\n"
"        <label> - cílové návěstí\n"
"    <hex mask> a <hex value> musí mít stejnou délku\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"CHYBA: příkaz musí mít 4 nebo 7 parametrů: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - místní identifikátor ECU. Délka by měla být 2 znaky pro KWP "
"nebo 4 pro CAN\n"
"        <rsp_len> - délka odpovědi na příkaz včetně bajtů kladné odpovědi, "
"odpovídá MinBytes z databáze ddt\n"
"        <offset> - posun v bajtech k prvnímu změněnému bajtu (začíná od 1, "
"nikoli od 0) \n"
"        <hex mask> - bitová maska pro změněné bity, 1 - měnitelný, 0 - "
"nedotknutelný\n"
"        <val step> - krok hodnoty\n"
"        <val offset> - posun hodnoty\n"
"        <val divider> - dělitel hodnoty\n"
"\n"

