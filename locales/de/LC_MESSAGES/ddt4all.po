msgid "Macros"
msgstr "Befehlsmakros"

msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"FEHLER: Befehl muss 5 Parameter haben: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - Lokale ECU-Kennung. Länge sollte 2 Zeichen für KWP oder 4 "
"für CAN sein\n"
"        <rsp_len> - Länge der Befehlsantwort einschließlich positiver "
"Antwortbytes, entspricht MinBytes aus der ddt-Datenbank\n"
"        <offset> - Offset in Bytes bis zum ersten geänderten Byte (beginnt "
"bei 1, nicht bei 0) \n"
"        <hex mask> - Bitmaske für geänderte Bits, 1 - änderbar, 0 - "
"unberührt\n"
"        <hex value> - Bitwert\n"
"    <hex mask> und <hex value> müssen die gleiche Länge haben\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"FEHLER: Befehl muss 6 Parameter haben: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - Lokale ECU-Kennung. Länge sollte 2 Zeichen für KWP oder 4 "
"für CAN sein\n"
"        <rsp_len> - Länge der Befehlsantwort einschließlich positiver "
"Antwortbytes, entspricht MinBytes aus der ddt-Datenbank\n"
"        <offset> - Offset in Bytes bis zum ersten geänderten Byte (beginnt "
"bei 1, nicht bei 0) \n"
"        <hex mask> - Bitmaske für geänderte Bits, 1 - änderbar, 0 - "
"unberührt\n"
"        <hex value> - Bitwert\n"
"        <label> - Ziel-Sprungmarke\n"
"    <hex mask> und <hex value> müssen die gleiche Länge haben\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"FEHLER: Befehl muss 4 oder 7 Parameter haben: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - Lokale ECU-Kennung. Länge sollte 2 Zeichen für KWP oder 4 "
"für CAN sein\n"
"        <rsp_len> - Länge der Befehlsantwort einschließlich positiver "
"Antwortbytes, entspricht MinBytes aus der ddt-Datenbank\n"
"        <offset> - Offset in Bytes bis zum ersten geänderten Byte (beginnt "
"bei 1, nicht bei 0) \n"
"        <hex mask> - Bitmaske für geänderte Bits, 1 - änderbar, 0 - "
"unberührt\n"
"        <val step> - Wert-Schrittweite\n"
"        <val offset> - Wert-Offset\n"
"        <val divider> - Wert-Teiler\n"
"\n"

