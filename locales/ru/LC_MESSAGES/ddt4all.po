msgid ""
"ERROR: command should have 5 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ОШИБКА: команда должна иметь 5 параметров: \n"
"    <команда> <lid> <rsp_len> <смещение> <hex-маска> <hex-значение>\n"
"        <lid> - локальный идентификатор ЭБУ. Длина должна быть 2 символа для "
"KWP или 4 для CAN\n"
"        <rsp_len> - длина ответа команды, включая байты положительного "
"ответа, равна MinBytes из базы ddt\n"
"        <смещение> - смещение в байтах до первого изменённого байта "
"(начинается с 1, а не с 0) \n"
"        <hex-маска> - битовая маска для изменённых битов, 1 - изменяемый, 0 "
"- неприкосновенный\n"
"        <hex-значение> - значение бита\n"
"    <hex-маска> и <hex-значение> должны иметь одинаковую длину\n"

msgid ""
"ERROR: command should have 6 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <hex value> - bit value\n"
"        <label> - label to go\n"
"    <hex mask> and <hex value> should have equal length\n"
msgstr ""
"ОШИБКА: команда должна иметь 6 параметров: \n"
"    <команда> <lid> <rsp_len> <смещение> <hex-маска> <hex-значение> <метка>\n"
"        <lid> - локальный идентификатор ЭБУ. Длина должна быть 2 символа для "
"KWP или 4 для CAN\n"
"        <rsp_len> - длина ответа команды, включая байты положительного "
"ответа, равна MinBytes из базы ddt\n"
"        <смещение> - смещение в байтах до первого изменённого байта "
"(начинается с 1, а не с 0) \n"
"        <hex-маска> - битовая маска для изменённых битов, 1 - изменяемый, 0 "
"- неприкосновенный\n"
"        <hex-значение> - значение бита\n"
"        <метка> - метка перехода\n"
"    <hex-маска> и <hex-значение> должны иметь одинаковую длину\n"

msgid ""
"ERROR: command should have 4 or 7 parameters: \n"
"    <command> <lid> <rsp_len> <offset> <hex mask> <hex value> <label>\n"
"        <lid> - ECUs local identifier. Length should be 2 simbols for KWP or "
"4 for CAN\n"
"        <rsp_len> - lengt of command response including positive response "
"bytes, equals MinBytes from ddt db\n"
"        <offset> - offeset in bytes to first changed byte (starts from 1 not "
"0) \n"
"        <hex mask> - bit mask for changed bits, 1 - changable, 0 - "
"untachable\n"
"        <val step> - value step\n"
"        <val offset> - value offset\n"
"        <val divider> - value divider\n"
"\n"
msgstr ""
"ОШИБКА: команда должна иметь 4 или 7 параметров: \n"
"    <команда> <lid> <rsp_len> <смещение> <hex-маска> <hex-значение> <метка>\n"
"        <lid> - локальный идентификатор ЭБУ. Длина должна быть 2 символа для "
"KWP или 4 для CAN\n"
"        <rsp_len> - длина ответа команды, включая байты положительного "
"ответа, равна MinBytes из базы ddt\n"
"        <смещение> - смещение в байтах до первого изменённого байта "
"(начинается с 1, а не с 0) \n"
"        <hex-маска> - битовая маска для изменённых битов, 1 - изменяемый, 0 "
"- неприкосновенный\n"
"        <шаг значения> - шаг значения\n"
"        <смещение значения> - смещение значения\n"
"        <делитель значения> - делитель значения\n"
"\n"

